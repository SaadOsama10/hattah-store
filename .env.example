# ─────────────────────────────────────────────────────────────
# HATTAH — Environment Variables
# Copy this file to .env.local for local development, and add the
# same values in Vercel → Project → Settings → Environment Variables
# for production/preview deployments.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# Public: safe to expose in the browser (read-only, protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret: NEVER expose in the browser. Used only in server actions
# (src/actions/*) to upload images and write to the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# WhatsApp ordering number, international format, no "+" or spaces
# (e.g. 905551234567). This is the single source of truth used by
# every "Order via WhatsApp" button on the site.
NEXT_PUBLIC_WHATSAPP_NUMBER=905551234567

# Social links shown in the footer (optional — the icons link nowhere
# until you set these to your real profile URLs).
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your-handle
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page

# Admin panel — /[locale]/admin
# The password used to log in to the dashboard.
ADMIN_PASSWORD=choose-a-strong-password

# A random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
